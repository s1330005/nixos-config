{
  programs.ghostty = {
    enable = true;
    settings = {
      theme = "Nvim Dark";
      window-padding-x = 8;
      window-padding-y = 8;
      window-padding-balance = true;
      font-family = [
        "JetBrainsMonoNL Nerd Font Mono"
        "IPAexGothic"
        "Noto Sans CJK JP"
      ];
      font-size = 12;
      font-style-bold = false;
      font-style-italic = false;
      font-style-bold-italic = false;
    };
  };
}
