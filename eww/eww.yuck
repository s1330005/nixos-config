(deflisten workspaces
  "~/.local/bin/eww-workspaces")

(deflisten time :initial ""
  "while :; do date '+%Y/%m/%d(%a) %-H:%M'; sleep $((60 - 10#$(date +%S))); done")

(deflisten volume_text :initial "0%"
  "~/.local/bin/eww-volume-text")

(deflisten sysinfo :initial "{\"cpu\":0,\"mem\":0}"
  "~/.local/bin/eww-sysinfo")

(deflisten gpu :initial ""
  "~/.local/bin/eww-gpu")

(deflisten net_icon :initial ""
  "~/.local/bin/eww-net-icon")

(deflisten vpn :initial "OFF"
  "~/.local/bin/eww-vpn")

(deflisten battery :initial "{\"available\":false,\"capacity\":0,\"charging\":false}"
  "~/.local/bin/eww-battery")

(defwidget workspace-btn [ws]
  (eventbox
    :onclick {"niri msg action focus-workspace " + jq(ws, ".id")}
    (label
      :class {jq(ws, ".is_active") == "true" ? "ws-label-active" : "ws-label"}
      :text {jq(ws, ".idx")})))

(defwidget app-label [app]
  (label
    :class {jq(app, ".focused") == "true" ? "ws-label-active" : "ws-label"}
    :text {replace(jq(app, ".name"), '"', '')}))

(defwidget workspaces []
  (box
    :class "ws-box"
    :valign "center"
    :orientation "h"
    :spacing 0
    :space-evenly false
    (box
      :spacing 0
      :space-evenly false
      (for ws in {jq(workspaces, ".workspaces")}
        (workspace-btn :ws {ws})))
    (label :class "ws-sep" :visible {jq(workspaces, ".apps | length") != "0"} :text "|")
    (box
      :spacing 0
      :space-evenly false
      (for app in {jq(workspaces, ".apps")}
        (app-label :app {app})))))

(defwidget clock []
  (centerbox
    :class "clock-box" :valign "center"
    :orientation "h"
    (box)
    {time}
    (box)))

(defwidget volume-widget []
  (eventbox
    :onscroll "if [ {} = up ]; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; fi"
    (box
      :class "vol-box" :valign "center"
      :spacing 6
      :space-evenly false
      (label :valign "center" :class "vol-icon" :text "VOL:")
      (label :valign "center" :xalign 0 :class "sysinfo-text" :text {volume_text}))))

(defwidget cpu-widget []
  (box
    :class "cpu-box" :valign "center"
    :spacing 6
    :space-evenly false
    (label :valign "center" :class "cpu-icon" :text "CPU:")
    (label :valign "center" :xalign 0 :class "sysinfo-text" :text {jq(sysinfo, ".cpu") + "%"})))

(defwidget gpu-widget []
  (box
    :visible {gpu != ""}
    :class "gpu-box" :valign "center"
    :spacing 6
    :space-evenly false
    (label :valign "center" :class "gpu-icon" :text "GPU:")
    (label :valign "center" :xalign 0 :class "sysinfo-text" :text {gpu + "%"})))

(defwidget mem-widget []
  (box
    :class "mem-box" :valign "center"
    :spacing 6
    :space-evenly false
    (label :valign "center" :class "mem-icon" :text "RAM:")
    (label :valign "center" :xalign 0 :class "sysinfo-text" :text {jq(sysinfo, ".mem") + "%"})))

(defwidget net-widget []
  (box
    :class "net-box" :valign "center"
    :spacing 6
    :space-evenly false
    (label :valign "center" :class "net-icon" :text "NET:")
    (label :valign "center" :xalign 0 :class "sysinfo-text" :text {net_icon == "󰌗" ? "ETH" : (net_icon == "" ? "WIFI" : "OFF")})))

(defwidget vpn-widget []
  (box
    :class "vpn-box" :valign "center"
    :spacing 6
    :space-evenly false
    (label :valign "center" :class "vpn-icon" :text "VPN:")
    (label :valign "center" :xalign 0 :class "sysinfo-text" :text {vpn})))

(defwidget battery-widget []
  (box
    :visible {jq(battery, ".available") == "true"}
    :class "battery-box" :valign "center"
    :spacing 6
    :space-evenly false
    (label
      :valign "center"
      :class "battery-icon"
      :text "BAT:")
    (label
      :valign "center"
      :xalign 0
      :class "sysinfo-text"
      :text {jq(battery, ".capacity") + "%" + (jq(battery, ".charging") == "true" ? "+" : "")})))

(defwindow bar-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "30px" :anchor "top center")
  (box :class "bar"))

(defwindow workspaces-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "4px" :y "0%" :width "10px" :height "30px" :anchor "top left")
  :reserve (struts :side "top" :distance "20px")
  (workspaces))

(defwindow clock
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%" :y "0%" :width "150px" :height "30px" :anchor "top center")
  :reserve (struts :side "top" :distance "20px")
  (clock))

(defwindow volume-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "354px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (volume-widget))

(defwindow cpu-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "268px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (cpu-widget))

(defwindow gpu-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "182px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (gpu-widget))

(defwindow mem-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "96px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (mem-widget))

(defwindow net-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "10px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (net-widget))

(defwindow battery-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "526px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (battery-widget))

(defwindow vpn-window
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "440px" :y "0%" :width "82px" :height "30px" :anchor "top right")
  :reserve (struts :side "top" :distance "20px")
  (vpn-widget))
